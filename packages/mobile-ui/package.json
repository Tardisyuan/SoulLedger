{
  "name": "@soulledger/mobile-ui",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "What the two React Native apps (mobile/ = soul, mobile-officer/ = officer) share: ui primitives, theme and tokens, fonts, i18n, feedback, network, the mobile platform ports, push core, the brand and dossier marks, the cold start view, deep links, the voice cache. TypeScript source, imported as @soulledger/mobile-ui/src/<module>; each app's Metro and jest compile it.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc.tsbuildinfo",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/"
  },
