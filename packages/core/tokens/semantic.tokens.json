  "app": {
    "$description": "Values only the apps draw: v4's translucent hairlines (the web composites them into --color-line / surface-3), the app's scrim, and the app names warn / pos-bg (aliases of the web's color.warning / color.success-tint since Design batch 40). Never emitted to CSS.",
    "$type": "color",
    "$extensions": {
      "org.soulledger": {
        "css": false
      }
    },
    "hair": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 0.08,
        "hex": "#FFFFFF"
      },
      "$extensions": {
        "org.soulledger": {
          "modes": {
            ".light": {
              "colorSpace": "srgb",
              "components": [0, 0, 0],
              "alpha": 0.08,
              "hex": "#000000"
            }
          }
        }
      }
    },
    "hair2": {
