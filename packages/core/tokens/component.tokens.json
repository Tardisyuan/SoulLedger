      "org.soulledger": {
        "modes": {
          ".light": 0.22
        }
      }
    }
  },
  "field": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "alpha": 0.05,
      "hex": "#FFFFFF"
    },
    "$extensions": {
      "org.soulledger": {
        "modes": {
