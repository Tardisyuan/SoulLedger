{
  "$description": "L2. Sizes, motion and faces owned by one component family (dossier seal, spine, desk, doors, toasts). Source of truth for the token block of frontend/app/globals.css (between the @tokens markers) and for packages/mobile-ui/src/theme.generated.ts: edit here, then `node scripts/build-tokens.mjs` (`--check` fails when the outputs are stale). Values were exported mechanically from globals.css on 2026-11-14, unchanged. DTCG 2025.10 format; $extensions.org.soulledger: modes, emit (\"value\": an alias written out as its value, not var()), bare (group name not part of the CSS name), css (false: app only), pendingDesign.",
  "seal-size": {
    "$type": "dimension",
    "$value": {
      "value": 96,
      "unit": "px"
    }
  },
  "mark": {
    "$type": "dimension",
    "$value": {
      "value": 16,
      "unit": "px"
    }
  },
  "stamp": {
    "$type": "duration",
    "$description": "落印 (Design batch 53 motion.seal): scale --stamp-scale -> 1, opacity 0 -> 1, no halo, for every seal moment. 200 on all three surfaces: with breathe, the one named exception to the four tiers, also inside a choreography (batch 60 P3 / P5: not 240). The same numbers as SEAL_MOTION in packages/core/src/config/motion.ts (sealMotionTokens.test.ts).",
    "$value": {
      "value": 200,
      "unit": "ms"
    }
  },
  "stamp-ease": {
    "$type": "cubicBezier",
    "$value": [0.2, 0.8, 0.2, 1]
  },
  "stamp-scale": {
    "$type": "number",
    "$value": 1.18
  },
  "stamp-reduced": {
    "$type": "duration",
    "$description": "Reduce motion: the seal fades in over this, without the scale.",
    "$value": {
      "value": 120,
      "unit": "ms"
    }
  },
  "now-breath": {
    "$type": "duration",
    "$description": "The spine's current point breathes --now-breath-count times, then stays still (Design batch 53 motion.breathe; BREATHE_MOTION).",
    "$value": {
      "value": 2.4,
      "unit": "s"
    }
  },
  "now-breath-count": {
    "$type": "number",
    "$value": 3
  },
  "judge-w": {
    "$type": "dimension",
    "$value": {
      "value": 380,
      "unit": "px"
    }
  },
  "verdict-rail-w": {
    "$type": "dimension",
    "$value": {
      "value": 288,
      "unit": "px"
    },
    "$extensions": {
      "org.soulledger": {
        "modes": {
          "@media (min-width: 1440px) :root": {
            "value": 320,
            "unit": "px"
          }
        }
      }
    }
  },
  "opt-h": {
    "$type": "dimension",
    "$value": {
      "value": 44,
      "unit": "px"
    },
