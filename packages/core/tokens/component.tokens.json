    "$value": {
      "value": 240,
      "unit": "ms"
    }
  },
  "stamp-ease": {
    "$type": "cubicBezier",
    "$value": [0.2, 0.8, 0.2, 1]
  },
  "now-breath": {
    "$type": "duration",
    "$value": {
      "value": 3.2,
      "unit": "s"
    }
  },
  "judge-w": {
