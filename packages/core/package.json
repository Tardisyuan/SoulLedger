{
  "name": "@soulledger/core",
  "version": "0.0.0",
  "private": true,
  "description": "Platform-independent SoulLedger layer: API contract, realtime clients, domain config, validation schemas and message bundles. No DOM, no React DOM, no Next.js.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./validations": "./src/validations/index.ts",
    "./platform": "./src/platform/index.ts",
    "./messages/*": "./messages/*",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "schema:generate": "openapi-typescript openapi/schema.yml -o src/api/generated/schema.ts"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.51.1",
    "@types/react": "^18.3.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "openapi-typescript": "^7.13.0",
    "react": "^18.3.1",
    "typescript": "^5.5.3"
  }
}
