{
  "name": "@soulledger/core",
  "version": "0.0.0",
  "private": true,
  "description": "Platform-independent SoulLedger layer: API contract, realtime clients, domain config, validation schemas and message bundles. No DOM, no React DOM, no Next.js.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./validations": "./src/validations/index.ts",
    "./platform": "./src/platform/index.ts",
    "./messages/*": "./messages/*",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  }
}
