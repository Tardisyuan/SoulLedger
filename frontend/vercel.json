{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": { "deploymentEnabled": { "main": false } },
  "installCommand": "cd .. && npx -y npm@11 ci --no-audit --no-fund",
  "buildCommand": "npx next build",
  "build": { "env": { "NEXT_PUBLIC_DEMO_MODE": "1", "NEXT_TELEMETRY_DISABLED": "1" } }
}
