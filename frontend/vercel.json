{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": { "deploymentEnabled": { "main": false } },
  "installCommand": "cd .. && npx -y npm@11 ci --no-audit --no-fund",
  "buildCommand": "mkdir -p public/api-docs && cp ../packages/core/openapi/schema.yml public/api-docs/schema.yml && npx next build",
  "redirects": [{ "source": "/api-docs", "destination": "/api-docs/index.html", "permanent": false }],
  "build": { "env": { "NEXT_PUBLIC_DEMO_MODE": "1", "NEXT_TELEMETRY_DISABLED": "1" } }
}
