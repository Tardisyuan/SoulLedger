trees/agent-ae26e3da1ca82321e/mobile-officer/src/screens/signOut.tsx",[],[],"/Users/tardis/Downloads/SoulLedger/.claude/worktrees/agent-ae26e3da1ca82321e/mobile-officer/src/screens/soulDetail.tsx",[],[],"/Users/tardis/Downloads/SoulLedger/.claude/worktrees/agent-ae26e3da1ca82321e/mobile-officer/src/screens/swipe.tsx",[],[],"/Users/tardis/Downloads/SoulLedger/.claude/worktrees/agent-ae26e3da1ca82321e/mobile-officer/src/screens/todo.tsx",[],[],"/Users/tardis/Downloads/SoulLedger/.claude/worktrees/agent-ae26e3da1ca82321e/mobile-officer/src/screens/todoFacts.tsx",[],[],"/Users/tardis/Downloads/SoulLedger/.claude/worktrees/agent-ae26e3da1ca82321e/mobile-officer/src/shared.ts",[],[],"/Users/tardis/Downloads/SoulLedger/.claude/worktrees/agent-ae26e3da1ca82321e/mobile-officer/src/shell.tsx",[],[],"/Users/tardis/Downloads/SoulLedger/.claude/worktrees/agent-ae26e3da1ca82321e/mobile-officer/src/__tests__/appFeel.test.tsx",[],[],{"ruleId":"120","severity":1,"message":"121","line":174,"column":6,"nodeType":"122","endLine":174,"endColumn":19,"suggestions":"123","suppressions":"124"},{"ruleId":"125","severity":2,"message":"126","line":129,"column":30,"nodeType":null,"endLine":129,"endColumn":36,"suppressions":"127"},{"ruleId":"120","severity":1,"message":"128","line":131,"column":6,"nodeType":"122","endLine":131,"endColumn":8,"suggestions":"129","suppressions":"130"},"react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'thread'. Either include it or remove the dependency array.","ArrayExpression",["131"],["132"],"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/tardis/Downloads/SoulLedger/.claude/worktrees/agent-ae26e3da1ca82321e/mobile-officer/src/screens/search.tsx:129:30\n  127 |   useEffect(() => {\n  128 |     // eslint-disable-next-line react-hooks/set-state-in-effect -- a fetch started once on mount; its loading state is the point\n> 129 |     if (initialQuery.trim()) search();\n      |                              ^^^^^^ Avoid calling setState() directly within an effect\n  130 |     // eslint-disable-next-line react-hooks/exhaustive-deps -- once per mount, with the query it was given\n  131 |   }, []);\n  132 |   // Typing searches after a pause; the timer reads `lastSent` when it fires, so a search 「搜索」 already sent is not repeated.",["133"],"React Hook useEffect has missing dependencies: 'initialQuery' and 'search'. Either include them or remove the dependency array.",["134"],["135"],{"desc":"136","fix":"137"},{"kind":"138","justification":"139"},{"kind":"138","justification":"140"},{"desc":"141","fix":"142"},{"kind":"138","justification":"143"},"Update the dependencies array to be: [outboxEntry, thread]",{"range":"144","text":"145"},"directive","only the entry coming and going matters","a fetch started once on mount; its loading state is the point","Update the dependencies array to be: [initialQuery, search]",{"range":"146","text":"147"},"once per mount, with the query it was given",[7606,7619],"[outboxEntry, thread]",[6542,6544],"[initialQuery, search]"]