# Copy to `.env` beside docker-compose.yml: `docker compose` reads it for the
# `${…}` values in the compose files. The names are the ones
# backend/config/settings.py reads — `DJANGO_SECRET_KEY` and
# `DJANGO_ALLOWED_HOSTS` were passed for months and read by nothing (IS-05).
# backend/tests/test_production.py checks every `${NAME}` the compose files
# reference is listed here.

# Database / Redis (compose builds the URLs from these)
DB_PASSWORD=changeme123
REDIS_PASSWORD=changeme456

# Django
SECRET_KEY=your-super-secret-key-here-change-in-production
# Required when DEBUG is off (every compose file except the dev override).
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
# How many proxies sit in front of Django; the production override sets 1
# (nginx). Leave unset for the dev stack.
TRUSTED_PROXY_COUNT=

# Encryption — REQUIRED when DEBUG is off.
# Without it, death-sync webhook secrets and death registration payloads are
# stored UNENCRYPTED; settings refuses to start when DEBUG=False and this is
# empty, and warns when DEBUG=True. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Sentry (optional)
SENTRY_DSN=

# Frontend — baked into the image at BUILD time (next.config.js `env:`), so it
# is a build arg, not a runtime variable; change it and rebuild. It must be the
# URL a browser can reach: behind nginx that is the public origin.
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1

# 灵魂聊天(Matrix / Synapse),见 docs/DEPLOYMENT.md「灵魂聊天」
MATRIX_ENABLED=False
MATRIX_PUBLIC_BASEURL=https://example.com/
MATRIX_SERVER_NAME=example.com
MATRIX_JWT_SECRET=your-jwt-secret-at-least-32-bytes
MATRIX_REGISTRATION_SHARED_SECRET=your-registration-shared-secret
MATRIX_USER_SALT=your-user-salt-never-rotate
SYNAPSE_DB_PASSWORD=changeme-synapse-db-password
